@{
    ViewData["Title"] = "Iniciar Sesión - Big Mama Burgers";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #121212;
            --card-bg: #1E1E1E;
            --primary: #FFC107;
            --secondary: #E53935;
            --accent: #FF9800;
            --text-light: #F5F5F5;
            --text-muted: #AAAAAA;
            --input-bg: rgba(0, 0, 0, 0.5);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
        }

        /* --- FONDO ÉPICO: HUMO Y BRASAS ANIMADAS --- */
        .fondo-epico {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -3;
            background-color: #0a0a0a;
            overflow: hidden;
        }

        .humo {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
        }

        .humo-1 {
            width: 600px;
            height: 600px;
            background: var(--secondary);
            top: -10%;
            left: -10%;
            animation: flotarHumo1 25s ease-in-out infinite alternate;
        }

        .humo-2 {
            width: 500px;
            height: 500px;
            background: var(--accent);
            bottom: -20%;
            right: -10%;
            animation: flotarHumo2 30s ease-in-out infinite alternate;
        }

        .humo-3 {
            width: 400px;
            height: 400px;
            background: var(--primary);
            top: 40%;
            left: 40%;
            animation: flotarHumo3 20s ease-in-out infinite alternate;
        }

        @@keyframes flotarHumo1 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(100px, 50px) scale(1.2);
            }
        }

        @@keyframes flotarHumo2 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(-100px, -50px) scale(1.1);
            }
        }

        @@keyframes flotarHumo3 {
            0% {
                transform: translate(-50%, -50%) scale(1);
            }

            100% {
                transform: translate(-40%, -60%) scale(1.3);
            }
        }

        .brasa {
            position: absolute;
            background: var(--primary);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--primary), 0 0 20px var(--secondary);
            animation: subirBrasa linear infinite;
        }

        @@keyframes subirBrasa {
            0% {
                transform: translateY(100vh) scale(0);
                opacity: 0;
            }

            20% {
                opacity: 1;
            }

            80% {
                opacity: 1;
            }

            100% {
                transform: translateY(-100px) scale(1.5);
                opacity: 0;
            }
        }

        /* HEADER */
        .main-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(18, 18, 18, 0.85);
            backdrop-filter: blur(20px) saturate(1.8);
            border-bottom: 2px solid rgba(255, 193, 7, 0.3);
            padding: 0.6rem 0;
        }

        .header-container {
            width: 92%;
            max-width: 1500px;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logo-wrapper {
            text-decoration: none;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-icon {
            font-size: 1.8rem;
            color: var(--primary);
            margin-right: 0.5rem;
            display: inline-block;
            vertical-align: middle;
        }

        .logo-main {
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: 3px;
            background: linear-gradient(135deg, #FFFFFF 0%, var(--primary) 40%, var(--accent) 70%, var(--primary) 100%);
            background-size: 300% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: shimmerLogo 4s ease-in-out infinite;
            display: inline-block;
            vertical-align: middle;
        }

        @@keyframes shimmerLogo {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .logo-sub {
            font-size: 0.7rem;
            letter-spacing: 5px;
            color: var(--primary);
            text-transform: uppercase;
            font-weight: 700;
            display: block;
            margin-top: 0.2rem;
        }

            .logo-sub::before, .logo-sub::after {
                content: '★';
                color: var(--secondary);
                margin: 0 8px;
                font-size: 0.6rem;
            }

        /* LOGIN SECTION */
        .login-section {
            flex: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8rem 1rem 4rem;
        }

        .login-card {
            max-width: 460px;
            width: 100%;
            background: rgba(30, 30, 30, 0.75);
            backdrop-filter: blur(25px) saturate(1.4);
            border-radius: 36px;
            padding: 2.8rem 2.2rem;
            border: 1px solid rgba(255, 193, 7, 0.3);
            transition: all 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            animation: fadeInUp 0.8s ease-out;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
            position: relative;
            overflow: hidden;
        }

            .login-card::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle at center, rgba(255, 193, 7, 0.05), transparent 60%);
                animation: rotateGlow 25s linear infinite;
                pointer-events: none;
            }

        @@keyframes rotateGlow {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .login-card:hover {
            transform: translateY(-6px) scale(1.01);
            border-color: var(--primary);
            box-shadow: 0 40px 80px rgba(255, 193, 7, 0.15);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(50px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
            position: relative;
            z-index: 1;
        }

        .login-logo {
            width: 150px;
            height: 150px;
            object-fit: contain;
            border-radius: 50%;
            border: 4px solid var(--primary);
            margin: 0 auto 1.2rem;
            display: block;
            box-shadow: 0 0 40px rgba(255, 193, 7, 0.3);
            animation: pulseBorder 3s ease-in-out infinite;
            background-color: #000;
        }

        @@keyframes pulseBorder {
            0%, 100% {
                border-color: var(--primary);
                box-shadow: 0 0 40px rgba(255, 193, 7, 0.3);
            }

            50% {
                border-color: var(--secondary);
                box-shadow: 0 0 60px rgba(229, 57, 53, 0.4);
            }
        }

        .login-header h1 {
            font-size: 2.2rem;
            font-weight: 900;
            font-family: 'Playfair Display', serif;
            background: linear-gradient(135deg, var(--primary), var(--accent), var(--primary));
            background-size: 300% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: shimmerTitle 4s ease-in-out infinite;
            margin-bottom: 0.3rem;
        }

        @@keyframes shimmerTitle {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .login-header p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* FORMULARIO */
        .form-group {
            margin-bottom: 1.2rem;
            position: relative;
            z-index: 1;
        }

            .form-group label {
                display: block;
                font-size: 0.75rem;
                font-weight: 800;
                color: var(--primary);
                margin-bottom: 0.4rem;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--accent);
                font-size: 1rem;
            }

        .form-control {
            width: 100%;
            padding: 0.85rem 1rem 0.85rem 2.8rem;
            background: var(--input-bg);
            border: 1px solid #444;
            border-radius: 50px;
            color: var(--text-light) !important;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--primary);
                background: rgba(0, 0, 0, 0.7);
                box-shadow: 0 0 25px rgba(255, 193, 7, 0.2);
            }

            .form-control::placeholder {
                color: #777;
            }

        .login-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            flex-wrap: wrap;
            gap: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            cursor: pointer;
        }

            .checkbox-label input[type="checkbox"] {
                accent-color: var(--primary);
                cursor: pointer;
            }

        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border: none;
            padding: 1rem;
            border-radius: 50px;
            color: #000;
            font-weight: 900;
            font-size: 1rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 0 0 25px rgba(255, 193, 7, 0.2);
            transition: all 0.4s ease;
            margin-top: 0.5rem;
            position: relative;
            z-index: 1;
        }

            .btn-login:hover {
                transform: translateY(-4px) scale(1.02);
                box-shadow: 0 15px 35px rgba(255, 193, 7, 0.4);
                background: linear-gradient(135deg, var(--accent), var(--primary));
            }

        .separator {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            margin: 1.5rem 0 1rem;
            position: relative;
            z-index: 1;
        }

        .separator-line {
            flex: 1;
            max-width: 80px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary), var(--secondary), var(--primary), transparent);
        }

        .separator-text {
            font-size: 0.7rem;
            color: var(--primary);
            font-weight: 700;
            letter-spacing: 2px;
        }

        .register-link {
            text-align: center;
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 193, 7, 0.15);
            font-size: 0.85rem;
            position: relative;
            z-index: 1;
        }

            .register-link a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 700;
            }

                .register-link a:hover {
                    color: var(--primary);
                    text-decoration: underline;
                }

        /* ALERTA DE ERROR */
        .alert-custom {
            background-color: rgba(229, 57, 53, 0.15);
            border: 1px solid var(--secondary);
            color: #ff8a80;
            border-radius: 15px;
            padding: 12px;
            margin-bottom: 20px;
            font-weight: bold;
            text-align: center;
            animation: shake 0.5s ease-in-out;
            position: relative;
            z-index: 1;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            50% {
                transform: translateX(5px);
            }

            75% {
                transform: translateX(-5px);
            }
        }

        /* FOOTER (IGUAL AL DE JUAN DE LA ROSA) */
        .footer {
            margin-top: auto;
            padding: 20px 0;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(0,0,0,0.3);
            position: relative;
            z-index: 10;
        }

        .footer-text {
            color: var(--text-muted);
            font-size: 0.8rem;
            letter-spacing: 1px;
        }

            .footer-text span {
                color: var(--primary);
                font-weight: 800;
            }

        @@media (max-width: 600px) {
            .login-section {
                padding: 6rem 0.8rem 2rem;
            }

            .login-card {
                padding: 2rem 1.5rem;
                border-radius: 24px;
            }

            .login-logo {
                width: 120px;
                height: 120px;
            }

            .login-header h1 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <!-- FONDO ÉPICO (Humo y Brasas) -->
    <div class="fondo-epico">
        <div class="humo humo-1"></div>
        <div class="humo humo-2"></div>
        <div class="humo humo-3"></div>
        
        <!-- Brasas animadas -->
        <div class="brasa" style="width: 8px; height: 8px; left: 10%; animation-duration: 8s; animation-delay: 0s;"></div>
        <div class="brasa" style="width: 5px; height: 5px; left: 20%; animation-duration: 12s; animation-delay: 2s;"></div>
        <div class="brasa" style="width: 10px; height: 10px; left: 35%; animation-duration: 10s; animation-delay: 4s;"></div>
        <div class="brasa" style="width: 6px; height: 6px; left: 50%; animation-duration: 15s; animation-delay: 1s;"></div>
        <div class="brasa" style="width: 7px; height: 7px; left: 65%; animation-duration: 9s; animation-delay: 3s;"></div>
        <div class="brasa" style="width: 9px; height: 9px; left: 80%; animation-duration: 11s; animation-delay: 5s;"></div>
        <div class="brasa" style="width: 4px; height: 4px; left: 90%; animation-duration: 14s; animation-delay: 2.5s;"></div>
        <div class="brasa" style="width: 6px; height: 6px; left: 45%; animation-duration: 13s; animation-delay: 6s;"></div>
    </div>

    <!-- ENCABEZADO -->
    <header class="main-header">
        <div class="header-container">
            <a href="/" class="logo-wrapper">
                <div>
                    <span class="logo-icon">🍔</span>
                    <span class="logo-main">BIG MAMA BURGERS</span>
                </div>
                <span class="logo-sub">Esencia Casera</span>
            </a>
        </div>
    </header>

    <!-- SECCIÓN DE LOGIN -->
    <section class="login-section">
        <div class="login-card">
            
            <div class="login-header">
                <img src="~/images/logo.jpg" alt="Big Mama Logo" class="login-logo" onerror="this.src='https://via.placeholder.com/150?text=LOGO'">
                <h1>Sistema de Gestión</h1>
                <p>Ingresa tus credenciales para acceder al sistema</p>
            </div>

            <form method="post" asp-action="Index">
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert-custom">
                        <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                    </div>
                }

                <div class="form-group">
                    <label>USUARIO</label>
                    <div class="input-icon">
                        <i class="fas fa-user"></i>
                        <input type="text" name="username" class="form-control" placeholder="Ej: jefe o juan" required autocomplete="username" />
                    </div>
                </div>

                <div class="form-group">
                    <label>CONTRASEÑA</label>
                    <div class="input-icon">
                        <i class="fas fa-lock"></i>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
                    </div>
                </div>

                <div class="login-options">
                    <label class="checkbox-label">
                        <input type="checkbox" name="RememberMe" value="true" /> Recordarme
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    <span><i class="fas fa-sign-in-alt" style="margin-right:8px;"></i> INGRESAR AL SISTEMA</span>
                </button>

                <div class="separator">
                    <span class="separator-line"></span>
                    <span class="separator-text">★ BIG MAMA ★</span>
                    <span class="separator-line"></span>
                </div>

                <div class="register-link">
                    <a href="#">Solo personal autorizado</a>
                </div>
            </form>
        </div>
    </section>

    <!-- PIE DE PÁGINA -->
    <footer class="footer">
        <div class="container">
            <div class="footer-text">
                &copy; 2026 <span>BIG MAMA BURGERS</span> | Sistema de Gestión de Ventas y Despacho
            </div>
        </div>
    </footer>

</body>
</html>